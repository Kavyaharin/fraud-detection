
import pandas as pd
from pathlib import Path

# Step 1: Set project directory
CURRENT_DIR = Path.cwd()

# Check whether Jupyter is running from the project root or notebooks folder
if (CURRENT_DIR / "data" / "refined").exists():
    PROJECT_DIR = CURRENT_DIR
elif (CURRENT_DIR.parent / "data" / "refined").exists():
    PROJECT_DIR = CURRENT_DIR.parent
else:
    raise FileNotFoundError(
        f"Cannot find data/refined folder from: {CURRENT_DIR}\n"
        "Please check the notebook's working directory."
    )

# Step 2: Define cleaned data directory
DATA_DIR = PROJECT_DIR / "data" / "refined"

print("Project directory:", PROJECT_DIR)
print("Data directory:", DATA_DIR)

# Step 3: Load all five cleaned datasets
cards_data = pd.read_csv(DATA_DIR / "cards_data.csv")
mcc_codes = pd.read_csv(DATA_DIR / "mcc_codes.csv")
fraud_labels = pd.read_csv(DATA_DIR / "train_fraud_labels.csv")
transactions = pd.read_csv(DATA_DIR / "transactions_data.csv")
users = pd.read_csv(DATA_DIR / "users_data.csv")

# Step 4: Display dataset information
print("\nAll five datasets loaded successfully!")

print("\nDataset shapes:")
print("Cards:", cards_data.shape)
print("MCC Codes:", mcc_codes.shape)
print("Fraud Labels:", fraud_labels.shape)
print("Transactions:", transactions.shape)
print("Users:", users.shape)
